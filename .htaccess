# AM Interiors — réglages serveur (OVH / Apache)

# Types de fichiers des modèles 3D et images
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# Compression des fichiers texte (pages, styles, scripts)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml model/gltf-binary
</IfModule>

# Mise en cache par le navigateur (le modèle 3D n'est téléchargé qu'une fois)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
</IfModule>
